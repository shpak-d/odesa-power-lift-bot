BOT_TOKEN=
# Числа через кому. Для груп ID зазвичай від'ємний. Порожній список забороняє запуск.
ALLOWED_CHAT_IDS=
TIMEZONE=Europe/Kyiv
CHECK_INTERVAL_MINUTES=10
MORNING_REPORT_TIME=08:00
WARNING_BEFORE_MINUTES=15
QUEUE_HOME=2.1
QUEUE_SECONDARY=4.1

# Підтверджено користувачем: ДТЕК Одеські електромережі.
OPERATOR_ID=odeska_oblast_oblenergo
# dtek_html — безкоштовна публічна сторінка; alerts_api — платний документований API.
SCHEDULE_PROVIDER=dtek_html
# Потрібен тільки для alerts_api. Ніколи не публікуйте ключ.
ALERTS_API_KEY=
DATABASE_PATH=data/bot.sqlite3
STALE_AFTER_MINUTES=30
HTTP_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO
